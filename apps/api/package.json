    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "6.19.0",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "nodemailer": "^7.0.10",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
