{
  "name": "agriprovider",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev:api": "pnpm --filter @agri/api dev",
    "dev:web": "pnpm --filter @agri/mobile web",
    "dev:mobile": "pnpm --filter @agri/mobile start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint apps packages --max-warnings 0",
    "test": "pnpm --filter @agri/api test",
    "db:generate": "pnpm --filter @agri/api db:generate",
    "db:migrate": "pnpm --filter @agri/api db:migrate",
    "seed": "pnpm --filter @agri/api seed",
    "build:web": "pnpm --filter @agri/mobile build:web",
    "test:web": "node scripts/test-web.mjs"
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "typescript-eslint": "^8.48.0",
    "typescript": "~6.0.3",
    "@playwright/test": "^1.56.1"
  }
}
